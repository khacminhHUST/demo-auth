# App
ENV=development
APP_NAME=Demo Auth API
CORS_ORIGIN=http://localhost:5173
FE_BASE_URL=http://localhost:5173

# Database (docker-compose postgres mặc định)
DATABASE_URL=postgresql://demo_user:demo_pass@localhost:5433/demo_db

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP / reset token
OTP_TTL_MINUTES=10
RESET_TOKEN_TTL_MINUTES=30
OTP_MAX_ATTEMPTS=5

# SMTP (mail cá nhân dùng làm master mail gửi đi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Demo App

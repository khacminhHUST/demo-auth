# File này dùng cho PRODUCTION deploy (docker-compose.yml ở gốc).
# Copy thành .env tại /opt/demo-auth/ trên server rồi điền giá trị thật, KHÔNG commit .env.
# Dev local vẫn dùng be/.env và fe/.env riêng như cũ, không liên quan file này.

# Image tag (build tại chỗ vẫn cần — là "nhãn gọi tên")
BE_IMAGE=demo-auth_be:local
FE_IMAGE=demo-auth_fe:local

# Domain — dùng cho CORS_ORIGIN/FE_BASE_URL bên be. Đổi ở đây KHÔNG tự đổi nginx.conf
# (server_name đang hardcode trong fe/nginx.conf, sửa domain thì sửa cả 2 chỗ rồi build lại fe).
DOMAIN=test.hawee.com.vn

# Thư mục chứa server.crt/server.key. Mặc định ./certs (cạnh docker-compose.yml).
# Nếu server đã có sẵn cert dùng chung cho nhiều dự án (vd wildcard *.hawee.com.vn),
# trỏ thẳng vào đó để khỏi copy trùng, ví dụ: CERTS_DIR=/home/ai-log/certs
CERTS_DIR=./certs

# PostgreSQL
POSTGRES_USER=demo_auth_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=demo_auth_db

# JWT — ký access token
JWT_ACCESS_SECRET=change-me-long-random-string

# SMTP — mail thật gửi OTP đăng ký / link đặt lại mật khẩu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Demo App

# Cố định project name cho Docker Compose bất kể chạy từ thư mục nào (giữ đúng volume pgdata)
COMPOSE_PROJECT_NAME=demo-auth
